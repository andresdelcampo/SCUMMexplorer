<Window x:Class="SCUMMexplorer.App.GameStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Status" Width="900" Height="780" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#101821" Foreground="#E7E0D2">
    <Window.Resources>
        <Style x:Key="ArtworkChoice" TargetType="Button">
            <Setter Property="Background" Value="#101821"/><Setter Property="Foreground" Value="#E7E0D2"/>
            <Setter Property="BorderBrush" Value="#E7E0D2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#273642"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B78442"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SpellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SpellNote" TargetType="ComboBox" BasedOn="{x:Static DataGridComboBoxColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SpellNoteEditor" TargetType="ComboBox" BasedOn="{x:Static DataGridComboBoxColumn.DefaultEditingElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LearnedCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="18" Height="18" Background="#101821" BorderBrush="#9FABAE" BorderThickness="1" CornerRadius="2">
                        <Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4" Stroke="#E7E0D2" StrokeThickness="2" Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#685132"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#E7E0D2"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B78442"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Game Status" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="SessionSummary" Foreground="#C6B99F" Margin="0,6,0,14" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto" MinHeight="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Staff / distaff" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="StaffLabel" Text="Unresolved"/>
            </StackPanel>
                <Button x:Name="StaffButton" Grid.Column="1" Style="{StaticResource ArtworkChoice}" Click="Staff_Click" Width="448" Height="48" HorizontalAlignment="Left"
                        AutomationProperties.Name="Staff possession" ToolTip="Toggle staff possession">
                    <Image x:Name="StaffImage" Width="448" Height="48" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Button>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Available notes" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoteIdentities" Foreground="#C6B99F" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0"/>
            </StackPanel>
            <Canvas x:Name="NoteButtons" Grid.Row="1" Grid.Column="1" Width="448" Height="40" HorizontalAlignment="Left"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StaffOrigin" Foreground="#9FABAE" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" Visibility="Collapsed"/>
                <TextBlock x:Name="NotesOrigin" Grid.Column="1" Foreground="#9FABAE" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" MinHeight="150">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="LearnAllButton" DockPanel.Dock="Right" Content="Mark all as learned" Click="LearnAll_Click" Padding="10,3"
                        ToolTip="Tick Learned on every spell; press Apply to keep the change"/>
                <TextBlock Text="Spell / draft sequences" FontSize="17"/>
            </DockPanel>
            <DataGrid x:Name="DraftGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" Background="#151F29" Foreground="#E7E0D2" RowBackground="#151F29"
                      AlternatingRowBackground="#192632" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334452"
                      HeadersVisibility="Column" BorderBrush="#334452" SelectionMode="Single" SelectionUnit="Cell" RowHeight="26">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#273642"/><Setter Property="Foreground" Value="#E7E0D2"/><Setter Property="Padding" Value="7,7"/></Style>
                    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="5,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/></Style>
                    <Style TargetType="DataGridRow"><Setter Property="IsEnabled" Value="{Binding Resolved}"/></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Spell / draft" Binding="{Binding Title}" IsReadOnly="True" Width="*" MinWidth="145">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SpellText}"><Setter Property="ToolTip" Value="{Binding TitleTip}"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridComboBoxColumn x:Name="Note1Column" Header="1" SelectedValueBinding="{Binding Note1, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Label" Width="48" ElementStyle="{StaticResource SpellNote}" EditingElementStyle="{StaticResource SpellNoteEditor}"/>
                    <DataGridComboBoxColumn x:Name="Note2Column" Header="2" SelectedValueBinding="{Binding Note2, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Label" Width="48" ElementStyle="{StaticResource SpellNote}" EditingElementStyle="{StaticResource SpellNoteEditor}"/>
                    <DataGridComboBoxColumn x:Name="Note3Column" Header="3" SelectedValueBinding="{Binding Note3, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Label" Width="48" ElementStyle="{StaticResource SpellNote}" EditingElementStyle="{StaticResource SpellNoteEditor}"/>
                    <DataGridComboBoxColumn x:Name="Note4Column" Header="4" SelectedValueBinding="{Binding Note4, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Label" Width="48" ElementStyle="{StaticResource SpellNote}" EditingElementStyle="{StaticResource SpellNoteEditor}"/>
                    <DataGridTemplateColumn Header="Learned" Width="68">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding Learned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LearnedCheck}" ToolTip="Toggle whether this draft is learned" AutomationProperties.Name="Learned"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Can reverse" IsReadOnly="True" Width="88">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9FABAE" ToolTip="Read only: this draft's source reverse capability" AutomationProperties.Name="Can reverse (read only)">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="—"/><Style.Triggers><DataTrigger Binding="{Binding Reversible}" Value="True"><Setter Property="Text" Value="✓"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="StateSourceColumn" Header="State source" Binding="{Binding Origin}" IsReadOnly="True" Width="190" Visibility="Collapsed">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SpellText}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Origin}"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Expander x:Name="FlagExpander" Grid.Row="3" Margin="0,10,0,0" Foreground="#E7E0D2" Visibility="Collapsed"
                  Header="Story: conversations, scenes and objects the game remembers">
            <StackPanel Margin="0,6,0,0">
                <TextBlock x:Name="FlagIntro" Foreground="#9FABAE" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox x:Name="FlagFilter" Background="#151F29" Foreground="#E7E0D2" BorderBrush="#334452" Padding="4,3" Margin="0,0,0,6"
                         TextChanged="FlagFilter_Changed" AutomationProperties.Name="Filter story events" ToolTip="Filter the list by name"/>
                <ListBox x:Name="FlagList" MaxHeight="150" Background="#151F29" BorderBrush="#334452" Foreground="#E7E0D2"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate><DataTemplate>
                        <DockPanel ToolTip="{Binding Detail}" Margin="2">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource LearnedCheck}" Margin="0,0,10,0" AutomationProperties.Name="{Binding Label}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Key}" Foreground="#6F7F86" FontSize="11" Margin="12,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="2"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Expander>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="EditMessage" Foreground="#C6B99F" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="ApplyButton" Content="Apply and close" Click="Apply_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton" Content="Cancel" Click="Close_Click" Padding="12,6" IsCancel="True"/>
                </StackPanel>
                <Expander x:Name="SourceExpander" DockPanel.Dock="Left" Header="Source and dependencies" Foreground="#9FABAE" Visibility="Collapsed" MaxWidth="500" Margin="0,0,12,0">
                    <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SourceEvidence" TextWrapping="Wrap" FontSize="11"/></ScrollViewer>
                </Expander>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
