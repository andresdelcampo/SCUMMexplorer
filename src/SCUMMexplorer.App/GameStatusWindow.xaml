<Window x:Class="SCUMMexplorer.App.GameStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game status" Width="900" Height="650" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#101821" Foreground="#E7E0D2">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Game status" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="SessionSummary" Foreground="#C6B99F" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="Edits are explicit exploration choices. They do not establish pickups, learning or replay prerequisites."
                       Foreground="#C6B99F" TextWrapping="Wrap" Margin="0,0,0,16"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Staff / distaff" FontWeight="SemiBold"/>
                <ComboBox x:Name="StaffChoice" Width="150" HorizontalAlignment="Left" Margin="0,6,0,4" IsEnabled="False">
                    <ComboBoxItem Content="Not held"/><ComboBoxItem Content="Held"/>
                </ComboBox>
                <TextBlock x:Name="StaffOrigin" Foreground="#9FABAE" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Available notes" FontWeight="SemiBold"/>
                <ComboBox x:Name="NoteCountChoice" Width="150" HorizontalAlignment="Left" Margin="0,6,0,4" IsEnabled="False" SelectionChanged="NoteCount_Changed"/>
                <TextBlock x:Name="NoteIdentities" Foreground="#C6B99F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="NotesOrigin" Foreground="#9FABAE" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Spell / draft sequences" FontSize="17" Margin="0,0,0,8"/>
            <DataGrid x:Name="DraftGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" IsReadOnly="True" Background="#151F29" Foreground="#E7E0D2" RowBackground="#151F29"
                      AlternatingRowBackground="#192632" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334452"
                      HeadersVisibility="Column" BorderBrush="#334452" SelectionMode="Single" SelectionUnit="Cell">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#273642"/><Setter Property="Foreground" Value="#E7E0D2"/><Setter Property="Padding" Value="9,7"/></Style>
                    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="7,5"/><Setter Property="BorderThickness" Value="0"/></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Draft" Binding="{Binding Title}" IsReadOnly="True" Width="74"/>
                    <DataGridComboBoxColumn x:Name="Note1Column" Header="Note 1" SelectedItemBinding="{Binding Note1}" Width="67"/>
                    <DataGridComboBoxColumn x:Name="Note2Column" Header="Note 2" SelectedItemBinding="{Binding Note2}" Width="67"/>
                    <DataGridComboBoxColumn x:Name="Note3Column" Header="Note 3" SelectedItemBinding="{Binding Note3}" Width="67"/>
                    <DataGridComboBoxColumn x:Name="Note4Column" Header="Note 4" SelectedItemBinding="{Binding Note4}" Width="67"/>
                    <DataGridTextColumn Header="Learning / reverse" Binding="{Binding Flags}" IsReadOnly="True" Width="142"/>
                    <DataGridTextColumn Header="Current value" Binding="{Binding Origin}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="EditMessage" Foreground="#C6B99F" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DockPanel>
                <Expander Header="Source and dependencies" Foreground="#9FABAE" MaxWidth="550" DockPanel.Dock="Left">
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SourceEvidence" TextWrapping="Wrap" FontSize="11"/></ScrollViewer>
                </Expander>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="EditButton" Content="Edit exploration state" Click="Edit_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Content="Apply changes" Click="Apply_Click" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="CancelButton" Content="Cancel edits" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button Content="Close" Click="Close_Click" Padding="12,6"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
