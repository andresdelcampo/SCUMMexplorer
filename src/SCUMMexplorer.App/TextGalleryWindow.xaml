<Window x:Class="SCUMMexplorer.App.TextGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Texts" Height="720" Width="1020" MinHeight="560" MinWidth="800"
        Background="#101821" Foreground="#E7E0D2" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="WORDS FROM THE GAME" Foreground="#B78442" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Game texts" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,2"/>
            <TextBlock x:Name="CoverageText" Foreground="#AAB4BA" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#151F29" BorderBrush="#334452" BorderThickness="1" CornerRadius="3" Padding="13" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" Height="34" Padding="8,5" FontSize="14"
                                 Background="#0B1117" Foreground="#E7E0D2" BorderBrush="#4A5962"
                                 ToolTip="Search the extracted game text" TextChanged="Filters_Changed"/>
                        <ComboBox x:Name="RoomFilter" Margin="0,8,0,0" Height="32" SelectionChanged="Filters_Changed"/>
                        <ComboBox x:Name="KindFilter" Margin="0,7,0,0" Height="32" SelectionChanged="Filters_Changed">
                            <ComboBoxItem Content="Every kind" Tag=""/>
                            <ComboBoxItem Content="Spoken lines" Tag="Spoken line"/>
                            <ComboBoxItem Content="Conversations and cutscenes" Tag="Conversation"/>
                            <ComboBoxItem Content="Object names" Tag="Object name"/>
                            <ComboBoxItem Content="Other labels and stored text" Tag="Other"/>
                        </ComboBox>
                        <TextBlock x:Name="ResultCount" Foreground="#B8AA8C" FontSize="11" Margin="1,8,0,0"/>
                        <Button x:Name="ExportButton" Content="Export visible text…" Click="Export_Click"
                                IsEnabled="False" Margin="0,8,0,0" Padding="9,7"
                                HorizontalAlignment="Stretch" Background="#273642" Foreground="#E7E0D2"
                                BorderBrush="#4A5962"/>
                    </StackPanel>
                    <ListBox x:Name="TextList" SelectionChanged="TextList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Foreground="#E7E0D2"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#334452" BorderThickness="0,0,0,1" Padding="5,9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ListHeading}" Foreground="#B8AA8C" FontSize="11"/>
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxHeight="42"
                                                   TextWrapping="Wrap" FontSize="14" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#151F29" BorderBrush="#334452" BorderThickness="1" CornerRadius="3" Padding="28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedKind" Text="SELECT A TEXT" Foreground="#B78442" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedHeading" FontSize="14" Foreground="#B8AA8C" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Image x:Name="RoomArtworkPreview" Grid.Row="1" Visibility="Collapsed" Height="150"
                           Stretch="Uniform" HorizontalAlignment="Left" Margin="0,16,0,0"
                           SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,20,0,18">
                        <TextBlock x:Name="SelectedText" FontSize="24" LineHeight="36" TextWrapping="Wrap"
                                   Foreground="#F3EBDD" VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PlayCutsceneButton" Content="Play this cutscene" Click="PlayCutscene_Click"
                                    Visibility="Collapsed" Padding="13,7" Margin="0,0,8,0"
                                    Background="#273642" Foreground="#E7E0D2" BorderBrush="#B78442" FontWeight="SemiBold"/>
                            <Button x:Name="VisitRoomButton" Content="Visit room" Click="VisitRoom_Click"
                                    Visibility="Collapsed" Padding="13,7" Margin="0,0,8,0"
                                    Background="#B78442" Foreground="#111820" BorderThickness="0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Expander Header="Source and extraction details" Foreground="#AAB4BA" Margin="0,10,0,0">
                            <StackPanel Margin="4,5,4,0">
                                <TextBlock x:Name="SourceDetails" Foreground="#B8AA8C" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ExtractionDetails" Foreground="#7F919B" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
