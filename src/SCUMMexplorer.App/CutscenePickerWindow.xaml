<Window x:Class="SCUMMexplorer.App.CutscenePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play Cutscene" Width="820" Height="640" MinWidth="620" MinHeight="460"
        Background="#151F29" Foreground="#E7E0D2" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Play Cutscene" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="PickerScope" Text="Choose a scene from anywhere in the game. Replay starts a fresh exploration session." TextWrapping="Wrap" Foreground="#AAB4BA" Margin="0,6,0,12"/>
            <TextBlock x:Name="CoverageSummary" TextWrapping="Wrap" Foreground="#B8AA8C" Margin="0,0,0,12"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Right" Width="190" Margin="12,0,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
                <ComboBoxItem Content="Scenes"/><ComboBoxItem Content="Dialogue and reactions"/><ComboBoxItem Content="Bonus scenes"/><ComboBoxItem Content="All playable"/><ComboBoxItem Content="Needs validation"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="8,5" ToolTip="Search titles, rooms and source evidence"/>
        </DockPanel>
        <ListBox x:Name="SceneList" Grid.Row="2" SelectionChanged="SceneList_SelectionChanged" MouseDoubleClick="SceneList_MouseDoubleClick"
                 Background="#0B1117" Foreground="#E7E0D2" BorderBrush="#334452" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="7,6">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" Foreground="#9B927F" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="SelectionNote" TextWrapping="Wrap" MaxHeight="70" Foreground="#AAB4BA"/>
            <Expander Header="Start and source details" Foreground="#B8AA8C" Margin="0,7,0,0">
                <TextBox x:Name="SourceDetails" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Background="#0B1117" Foreground="#AAB4BA" BorderThickness="0"/>
            </Expander>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Close" IsCancel="True" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="PlayButton" Content="Play" Click="Play_Click" IsEnabled="False" Padding="24,7" Background="#B78442" Foreground="#111820" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
