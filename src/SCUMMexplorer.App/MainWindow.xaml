<Window x:Class="SCUMMexplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SCUMMexplorer.App"
        mc:Ignorable="d"
        Title="SCUMMexplorer" Height="760" Width="1180" MinHeight="600" MinWidth="900"
        Background="#101821" Foreground="#E7E0D2">
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E7E0D2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#15212B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The dark theme's buttons. WPF's own template paints a disabled button light grey whatever its
             Background (the playback bar's Pause and Skip, the sound player); this one keeps it dark and dims its
             text. Colours set on a button still apply. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#273642"/>
            <Setter Property="Foreground" Value="#E7E0D2"/>
            <Setter Property="BorderBrush" Value="#4A5962"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                            <Border x:Name="Shade" Background="#FFFFFF" Opacity="0" CornerRadius="2"/>
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B78442"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shade" Property="Background" Value="#000000"/>
                                <Setter TargetName="Shade" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#18222B"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2C3A45"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="#5F6B73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B78442"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="PanelSection" TargetType="Expander">
            <Setter Property="Foreground" Value="#E7E0D2"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="RoomPanButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2934"/>
            <Setter Property="Foreground" Value="#E7E0D2"/>
            <Setter Property="BorderBrush" Value="#334452"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PanButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Path Width="5" Height="9" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PanButtonChrome" Property="Background" Value="#273A48"/>
                                <Setter Property="Foreground" Value="#F0C47D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PanButtonChrome" Property="Background" Value="#B78442"/>
                                <Setter Property="Foreground" Value="#111820"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PanButtonChrome" Property="Background" Value="#151F29"/>
                                <Setter Property="Foreground" Value="#53616B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#192632" BorderBrush="#334452" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="SCUMMexplorer" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Step into the game world" Foreground="#B8AA8C" FontSize="13" VerticalAlignment="Center" Margin="12,2,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="AdvancedModeToggle" Content="Advanced" IsChecked="False" Click="AdvancedModeToggle_Click"
                              VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#D2C7B5"
                              ToolTip="Show SCUMM resource lists, script state, and diagnostic controls."/>
                    <Button Content="Game Texts" Click="GameTexts_Click" Padding="13,8" Margin="0,9,8,9" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                    <Button Content="Open Game Folder…" Click="OpenFolder_Click" Padding="16,8" Margin="0,9,0,9" Background="#B78442" Foreground="#111820" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#151F29" BorderBrush="#334452" BorderThickness="0,0,1,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,4,0,18">
                        <TextBlock Text="EXPLORE" Foreground="#9B927F" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="GameTitle" Text="No game open" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <TextBlock x:Name="GameInfo" Text="Choose a game folder to begin." Foreground="#AAB4BA" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer x:Name="RoomCardScroll" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-5,0,-3,8">
                        <WrapPanel x:Name="RoomCardList"/>
                    </ScrollViewer>
                    <TreeView x:Name="ResourceTree" Grid.Row="1" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="#E7E0D2" SelectedItemChanged="ResourceTree_SelectedItemChanged"/>
                </Grid>
            </Border>
            <Grid x:Name="ContentPanel" Grid.Column="1" Margin="26">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock x:Name="PageTitle" Text="Welcome to SCUMMexplorer" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Open a game folder to step inside." Foreground="#AAB4BA" Margin="0,3,0,0"/>
                    <Button x:Name="ConnectionsButton" Content="Connections" Visibility="Collapsed"
                            Click="ConnectionsButton_Click" HorizontalAlignment="Left" Margin="0,9,0,0"
                            Padding="10,5" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#0B1117" BorderBrush="#334452" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid x:Name="RoomDisplayLayout" Visibility="Collapsed" SizeChanged="RoomDisplayLayout_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="10,8,10,6" VerticalAlignment="Center">
                                <CheckBox x:Name="NormalRoomWidthToggle" Content="Original framing" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#E7E0D2"
                                          ToolTip="Show up to 320 stored horizontal pixels, enlarged to fit the available view. Pan to see the rest of a wide room."
                                          Checked="NormalRoomWidthToggle_Changed" Unchecked="NormalRoomWidthToggle_Changed"/>
                                <CheckBox x:Name="CameraPanToggle" Content="Pan to the camera on entry" IsChecked="False" Visibility="Collapsed"
                                          Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#E7E0D2"
                                          ToolTip="Presentation only: a room entered in the session slides from its left edge to where its camera is, 8 source pixels a step (ScummVM's scroll step; not the game's timing). In the game, a room load or loadRoomWithEgo puts the camera there at once; only script pans and walks scroll."/>
                                <CheckBox x:Name="GamePointerToggle" Content="Pointer as game input" IsChecked="False" Visibility="Collapsed"
                                          Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#E7E0D2"
                                          Checked="GamePointerToggle_Changed" Unchecked="GamePointerToggle_Changed"
                                          ToolTip="Assumed input, off by default. While on, in interactive mode, the pointer's room position is given to the game as its virtual mouse, and moving onto a different object advances one frame, so the input loop (script 006) reacts to the hover as it would in the game: for example, script 008 shows the object's close-up in the verb area. No click is sent. With the pointer off the room, the game is taken to have no pointer over it."/>
                                <CheckBox x:Name="GameKeysToggle" Content="Keys as game input" IsChecked="False" Visibility="Collapsed"
                                          Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#E7E0D2"
                                          ToolTip="Assumed input, off by default. While on, in interactive mode, keys typed in the window (not in a text box) go to the game as ScummVM hands them to the input script (script 005, runInputScript(4, key, 1)): the note letters q-w-e-r-t-y-u-i and c-d-e-f-g-a-b-C play distaff notes, &lt; and &gt; change the text speed, F5 opens the save screen (Room 70), F6 cycles music and effects, F7 the animation speed, Ctrl+V prints the version, and Escape turns the close-up off or cancels a draft being played. The engine's own keys (F8 restart, space pause, '.' talk stop) and Escape during a cutscene are not sent, and say so."/>
                                <CheckBox x:Name="VerbAreaToggle" Content="Show verb area" IsChecked="False" Visibility="Collapsed"
                                          Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#E7E0D2"
                                          Checked="VerbAreaToggle_Changed" Unchecked="VerbAreaToggle_Changed"
                                          ToolTip="Presentation only, off by default. Draws the verb area below the room (screen rows 144-199) from the session's verb slots (verbOps state): every image verb that is on or dim, at its position, with the image it was given (the distaff notes come from Room 01's objects 100-151). It shows game state, but the drawing is not the game's: text verbs, the note letters scripts print there, highlight colours and redraw timing are not drawn."/>
                                <CheckBox x:Name="RoomNavigationToggle" Content="Show exits" Visibility="Collapsed" IsChecked="False"
                                          Margin="0,0,14,0" Foreground="#E7E0D2"
                                          Checked="RoomNavigationToggle_Changed" Unchecked="RoomNavigationToggle_Changed"/>
                                <CheckBox x:Name="RoomMaskToggle" Content="Show depth areas" Visibility="Collapsed"
                                          Margin="0,0,14,0" Foreground="#E7E0D2" IsEnabled="False"
                                          Checked="RoomMaskToggle_Changed" Unchecked="RoomMaskToggle_Changed"/>
                                <CheckBox x:Name="WalkBoxToggle" Content="Show walk boxes" Visibility="Collapsed"
                                          Foreground="#E7E0D2" IsEnabled="False"
                                          Checked="WalkBoxToggle_Changed" Unchecked="WalkBoxToggle_Changed"/>
                            </WrapPanel>
                            <Grid x:Name="RoomViewportHost" Grid.Row="1" SizeChanged="RoomViewportHost_SizeChanged">
                                <StackPanel x:Name="RoomDisplayGroup" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ScrollViewer x:Name="RoomViewport" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Focusable="True" SizeChanged="RoomViewport_SizeChanged" ScrollChanged="RoomViewport_ScrollChanged"
                                                  PreviewKeyDown="RoomViewport_PreviewKeyDown"
                                                  LostKeyboardFocus="RoomViewport_LostKeyboardFocus" Background="#0B1117">
                                        <Grid x:Name="RoomSceneSurface">
                                            <Image x:Name="RoomPreview" Visibility="Collapsed" Stretch="Uniform" SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonUp="RoomPreview_MouseLeftButtonUp" MouseLeftButtonDown="RoomPreview_MouseLeftButtonDown"
                                                   MouseMove="RoomPreview_MouseMove" MouseLeave="RoomPreview_MouseLeave"/>
                                            <Image x:Name="RoomActorOverlay" Visibility="Collapsed" Stretch="Uniform" SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
                                            <Canvas x:Name="RoomNavigationOverlay" Visibility="Collapsed" ClipToBounds="True" IsHitTestVisible="False" SizeChanged="RoomNavigationOverlay_SizeChanged"/>
                                            <Canvas x:Name="WalkBoxOverlay" Visibility="Collapsed" ClipToBounds="True" IsHitTestVisible="False" SizeChanged="WalkBoxOverlay_SizeChanged"/>
                                            <Canvas x:Name="HotspotHighlightOverlay" Visibility="Collapsed" ClipToBounds="True" IsHitTestVisible="False" SizeChanged="HotspotHighlightOverlay_SizeChanged"/>
                                            <Image x:Name="RoomMessageOverlay" Visibility="Collapsed" Stretch="Uniform" SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
                                        </Grid>
                                    </ScrollViewer>
                                    <StackPanel x:Name="VerbStripPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <Border x:Name="VerbStripBorder" Background="#000000" BorderBrush="#334452" BorderThickness="0,1,0,0" HorizontalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="VerbStripImage" Stretch="Fill" SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       MouseLeftButtonUp="VerbStripImage_MouseLeftButtonUp" MouseMove="VerbStripImage_MouseMove"/>
                                                <Image x:Name="VerbMessageOverlay" Visibility="Collapsed" Stretch="Fill" SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <Grid x:Name="RoomScrollButtonsPanel" Width="{Binding ActualWidth, ElementName=RoomViewport}" Height="24"
                                          HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="ScrollRoomLeftButton" Grid.Column="0" Tag="M 5,0 L 0,4.5 L 5,9" ToolTip="Scroll room left" AutomationProperties.Name="Scroll room left"
                                                Click="PanButton_Click" PreviewMouseLeftButtonDown="PanButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PanButton_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="PanButton_LostMouseCapture" Style="{StaticResource RoomPanButton}" BorderThickness="0,1,1,0" BorderBrush="#334452"/>
                                        <Button x:Name="ScrollRoomRightButton" Grid.Column="1" Tag="M 0,0 L 5,4.5 L 0,9" ToolTip="Scroll room right" AutomationProperties.Name="Scroll room right"
                                                Click="PanButton_Click" PreviewMouseLeftButtonDown="PanButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PanButton_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="PanButton_LostMouseCapture" Style="{StaticResource RoomPanButton}" BorderThickness="0,1,0,0" BorderBrush="#334452"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <!-- MinHeight: the controls' usual height with the music row and a two-line note, so the
                                 room above keeps its size while they change (a cutscene's rooms, its notes). -->
                            <StackPanel x:Name="RoomControlsPanel" Grid.Row="2" Margin="0,4,0,8" MinHeight="108"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <StackPanel x:Name="SceneInteractionCard" MaxWidth="520" HorizontalAlignment="Center" Margin="8,0,8,8">
                                    <DockPanel x:Name="SceneSessionBar" LastChildFill="False" HorizontalAlignment="Center" Margin="0,0,0,5">
                                        <TextBlock x:Name="SessionStatusText" Foreground="#B8AA8C" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel x:Name="SessionActions" Visibility="Collapsed" Orientation="Horizontal">
                                            <Button Content="↺ Restart" ToolTip="Restart exploration from the boot state." Click="ResetSession_Click" Padding="8,4" Margin="0,0,5,0"
                                                    Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                            <Button x:Name="AdvanceFrameButton" Content="Continue ▸" ToolTip="Continue the scene: advance scripts paused at a frame boundary." Click="AdvanceFrame_Click" Padding="8,4"
                                                    Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel x:Name="PlaybackBar" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5" Visibility="Collapsed">
                                        <Button x:Name="PlaybackPauseButton" Content="⏸ Pause" Click="PlaybackPause_Click" Padding="8,4" Margin="0,0,5,0" IsEnabled="False"
                                                Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"
                                                ToolTip="Pause or play the scene (space). While paused, Continue ▸ in the advanced session bar plays one frame."/>
                                        <Button x:Name="SkipCutsceneButton" Content="⏭ Skip (Esc)" Click="SkipCutscene_Click" Padding="8,4" Margin="0,0,5,0" IsEnabled="False"
                                                Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962" ToolTipService.ShowOnDisabled="True"/>
                                        <Button x:Name="CutsceneMenuButton" Content="Play a cutscene ▾" Click="CutsceneMenu_Click" Padding="8,4"
                                                Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"
                                                ToolTip="Play a known cutscene from a stated start: a fresh session after the boot, the room opened from the catalog, and the object's verb run directly (an exploration action, not the game's click)."/>
                                    </StackPanel>
                                    <TextBlock x:Name="ObjectsNote" Text="Choose a scene." Foreground="#AAB4BA" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <StackPanel x:Name="ObjectActionPanel" Visibility="Collapsed" Margin="0,3,0,0">
                                        <TextBlock x:Name="ObjectActionNote" Foreground="#D2C7B5" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <StackPanel x:Name="ObjectVerbButtons" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                        <Expander x:Name="ObjectActionTraceExpander" Header="Advanced action details" Visibility="Collapsed"
                                                  Foreground="#E7E0D2" Background="#0B1117" Margin="0,3,0,0">
                                            <TextBox x:Name="ObjectActionTraceOutput" IsReadOnly="True" AcceptsReturn="True"
                                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     Background="#0B1117" Foreground="#E7E0D2" BorderThickness="0"
                                                     FontFamily="Consolas" FontSize="11" Height="140"/>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="RoomMusicPanel" Visibility="Collapsed" HorizontalAlignment="Center" MaxWidth="720">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="MUSIC" Style="{StaticResource PanelHeading}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="RoomCuePlayButton" Content="▶" ToolTip="Play room cue" AutomationProperties.Name="Play room cue" Click="RoomCuePlay_Click" Width="28" Height="24" Margin="0,0,3,0" Padding="0" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                        <Button x:Name="RoomCuePauseButton" Content="Ⅱ" ToolTip="Pause room cue" AutomationProperties.Name="Pause room cue" Click="RoomCuePause_Click" Width="28" Height="24" Margin="0,0,3,0" Padding="0" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                        <Button x:Name="RoomCueStopButton" Content="■" ToolTip="Stop room cue" AutomationProperties.Name="Stop room cue" Click="RoomCueStop_Click" Width="28" Height="24" Margin="0,0,7,0" Padding="0" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                        <TextBlock x:Name="RoomCueTitle" MaxWidth="220" Foreground="#E7E0D2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RoomCueTime" Text="0:00 / 0:00" Visibility="Collapsed" Foreground="#B8AA8C" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="RoomCueEvidence" Visibility="Collapsed" Foreground="#B8AA8C" FontSize="11"/>
                                        <TextBlock x:Name="RoomCueStatus" Visibility="Collapsed" Foreground="#B8AA8C" FontSize="11"/>
                                        <Button x:Name="RoomMusicMoreButton" Content="Other possible music" Visibility="Collapsed"
                                                ToolTip="Possible tracks come from static room and object script paths." Padding="6,2"
                                                Click="RoomMusicMore_Click"
                                                Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <Border Padding="5" Background="#101820">
                                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <StackPanel x:Name="RoomMusicButtons" HorizontalAlignment="Center"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock x:Name="RoomMusicNote" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="CostumePanel" Visibility="Collapsed" Margin="28">
                            <ScrollViewer x:Name="CostumePoseScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          SizeChanged="CostumePoseScrollViewer_SizeChanged"
                                          Background="#0B1117">
                                <WrapPanel x:Name="CostumePoseGallery" Margin="18" HorizontalAlignment="Center"/>
                            </ScrollViewer>
                            <Grid IsHitTestVisible="False">
                                <TextBlock x:Name="CostumeMessage" Text="Reading costume…" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" MaxWidth="460" Margin="28" TextWrapping="Wrap"
                                           TextAlignment="Center" Foreground="#AAB4BA"/>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                            <TextBlock Text="SOUND PLAYER" Foreground="#B78442" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="AudioTitle" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,3"/>
                            <TextBlock x:Name="AudioDescription" Foreground="#AAB4BA" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <ComboBox x:Name="AudioFormatCombo" Width="160" HorizontalAlignment="Center" Margin="0,0,0,14" SelectionChanged="AudioFormatCombo_SelectionChanged" Visibility="Collapsed">
                                <ComboBoxItem Content="PC speaker"/>
                                <ComboBoxItem Content="AdLib FM"/>
                            </ComboBox>
                            <StackPanel x:Name="AdlibGainPanel" Visibility="Collapsed" Margin="12,0,12,12">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="AdLib level" Foreground="#E7E0D2" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AdlibGainValue" Text="+6.0 dB" Foreground="#B8AA8C" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Slider x:Name="AdlibGainSlider" Minimum="0" Maximum="24" Value="6" TickFrequency="3"
                                        IsSnapToTickEnabled="False" ValueChanged="AdlibGainSlider_ValueChanged"
                                        ToolTip="AdLib playback gain. Peaks are kept below clipping; some tracks may reach their safe maximum before 24 dB."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PlayButton" Content="▶" ToolTip="Play" AutomationProperties.Name="Play" Click="PlayButton_Click" Width="44" Height="36" Margin="4" FontSize="15" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                <Button x:Name="PauseButton" Content="Ⅱ" ToolTip="Pause" AutomationProperties.Name="Pause" Click="PauseButton_Click" Width="44" Height="36" Margin="4" FontSize="15" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                                <Button x:Name="StopButton" Content="■" ToolTip="Stop" AutomationProperties.Name="Stop" Click="StopButton_Click" Width="44" Height="36" Margin="4" FontSize="15" Background="#273642" Foreground="#E7E0D2" BorderBrush="#4A5962"/>
                            </StackPanel>
                            <TextBlock x:Name="AudioTime" Text="0:00 / 0:00" Foreground="#B8AA8C" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                        <Grid x:Name="ScriptPanel" Visibility="Collapsed" Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ScriptNote" Text="DOS LOOM old-v3 bytecode disassembly. Scripts are not executed."
                                       Foreground="#B8AA8C" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ScrollViewer Grid.Row="1" MaxHeight="76" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                <StackPanel x:Name="ScriptEventButtons"/>
                            </ScrollViewer>
                            <TextBox x:Name="ScriptOutput" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                                     IsReadOnlyCaretVisible="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#0B1117" Foreground="#E7E0D2" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="13" Padding="4"/>
                        </Grid>
                        <StackPanel x:Name="PreviewMessage" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="30">
                            <TextBlock Text="ROOM BACKGROUND" Foreground="#B78442" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PreviewTitle" Text="Your game will appear here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                            <TextBlock x:Name="PreviewDescription" Text="SCUMMexplorer is being built around game concepts: rooms first, with their objects, scripts, characters and sounds close at hand." TextWrapping="Wrap" TextAlignment="Center" Foreground="#AAB4BA"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" Foreground="#9B927F" Margin="0,12,0,0"/>
            </Grid>
            <Border x:Name="RoomObjectPanel" Grid.Column="2" Background="#151F29" BorderBrush="#334452" BorderThickness="1,0,0,0" Padding="12,14,4,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Technical inspection panel; normal mode keeps the scene and its contextual controls in the center. -->
                    <StackPanel Margin="0,4,8,8">
                        <DockPanel>
                            <CheckBox x:Name="SessionModeToggle" DockPanel.Dock="Right" Content="Interactive" IsChecked="True"
                                      ToolTip="Interactive mode: a click on the room is the game's click (scripts 005–007, assumed input): Bobbin walks over and uses what is there (verb 0x38; doorways lead on), and a double click also looks at it (verb 0x36). Uncheck for inspection mode, where a click cycles an object's stored images and no script runs."
                                      Checked="SessionMode_Changed" Unchecked="SessionMode_Changed"
                                      Foreground="#E7E0D2" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Text="IN THIS ROOM" Foreground="#B78442" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel x:Name="VerbAreaPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Border DockPanel.Dock="Left" Background="#000000" BorderBrush="#4A5962" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Top">
                                <Image x:Name="VerbAreaImage" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock x:Name="VerbAreaText" Foreground="#AAB4BA" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <Expander x:Name="RoomNavigationPanel" Style="{StaticResource PanelSection}" Visibility="Collapsed" IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock x:Name="RoomNavigationHeader" Text="DOORWAYS" Style="{StaticResource PanelHeading}"/>
                                </Expander.Header>
                                <WrapPanel x:Name="RoomNavigationButtons" Margin="0,4,0,0"/>
                            </Expander>
                            <Expander x:Name="ObjectListSection" Style="{StaticResource PanelSection}" Visibility="Collapsed" IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock x:Name="ObjectListHeader" Text="HOTSPOTS" Style="{StaticResource PanelHeading}"/>
                                </Expander.Header>
                                <StackPanel x:Name="ObjectList" Margin="0,4,0,0"/>
                            </Expander>
                            <StackPanel x:Name="ObjectAssetSection" Margin="0,4,0,0">
                                <Image x:Name="ObjectAssetPreview" Height="72" Stretch="Uniform" Visibility="Collapsed" Margin="0,8,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="ObjectAssetDescription" Foreground="#B8AA8C" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Expander x:Name="RoomEntryTraceExpander" Header="Advanced room details"
                                      Visibility="Collapsed" IsExpanded="False" Margin="0,10,0,0"
                                      Foreground="#E7E0D2" Background="#0B1117">
                                <StackPanel>
                                    <TextBox x:Name="RoomEntryTraceOutput" IsReadOnly="True" AcceptsReturn="True"
                                             IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             Background="#0B1117" Foreground="#E7E0D2" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11" Padding="4" Height="150"/>
                                    <StackPanel x:Name="RoomEntryEventButtons" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#192632" BorderBrush="#334452" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Text="No game loaded" Foreground="#9B927F" FontSize="11" Margin="14,0" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
