<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Loom\Text\loom-glossary.json" LogicalName="SCUMMexplorer.Core.loom-glossary.json" />
    <EmbeddedResource Include="Loom\Cd\loom-cd-glossary.json" LogicalName="SCUMMexplorer.Core.loom-cd-glossary.json" />
    <EmbeddedResource Include="Loom\Ega\loom-ega-reviewed-glossary.json" LogicalName="SCUMMexplorer.Core.loom-ega-reviewed-glossary.json" />
  </ItemGroup>

  <!-- Layering: SCUMMexplorer.Core.Scumm (engine, any game) must not see SCUMMexplorer.Core.Loom (LOOM, all editions; Loom/Cd and Loom/Ega are edition code). -->
  <ItemGroup>
    <Using Include="SCUMMexplorer.Core.Scumm" />
    <Using Include="SCUMMexplorer.Core.Domain" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NukedOPL3Sharp" Version="1.3.1" />
    <PackageReference Include="Mt32emu.net" Version="1.0.0" />
  </ItemGroup>

</Project>
